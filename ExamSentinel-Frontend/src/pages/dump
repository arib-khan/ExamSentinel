              const handleLogout = () => {
    uiDispatch(showLogoutConfirmation());
  };

  const confirmLogout = () => {
    logExamEvent("STUDENT_LOGOUT_CLICKED");
    uiDispatch(hideLogoutConfirmation());
    authDispatch(logout())
      .unwrap()
      .then(() => {
        // toast.success("Logout successful");
        logExamEvent("STUDENT_LOGOUT_SUCCESS");
        navigate("/");
      })
      .catch(() => {
        logExamEvent("LOGOUT_FAILED");
        // toast.error("Logout failed");
      });
  };

  const cancelLogout = () => {
    uiDispatch(hideLogoutConfirmation());
  };


