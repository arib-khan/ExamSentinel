# --- already required by the existing backend (the first error you hit: "secretOrPrivateKey must have a value") ---
TOKEN_SECRET=change-me-long-random-string
REFRESH_TOKEN_SECRET=change-me-another-long-random-string

# --- Supabase (PostgreSQL). Supabase > Connect > "Session pooler" URI (port 5432) ---
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres
# Max DB connections per Node process (keep small on Supabase free tier; multiply by cluster workers)
PG_POOL_MAX=5
# Set to false only for a LOCAL Postgres without SSL (Supabase needs SSL, the default)
# PG_SSL=false

# --- Live video interviews (LiveKit). Free cloud account: https://cloud.livekit.io  (Settings > Keys) ---
LIVEKIT_URL=wss://examsentinel-oug0jili.livekit.cloud
LIVEKIT_API_KEY=APIQFoAfU4S2htL
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Public address of the web app (used in invitation links)
FRONTEND_URL=http://localhost:5173
# Optional tuning
# LIVEKIT_TOKEN_TTL=600            seconds a join token is valid (short on purpose)
# LIVE_JOIN_EARLY_MINUTES=10       candidate can join this long before the start
# LIVE_HOST_EARLY_MINUTES=60       interviewer can open the room this long before the start
# LIVE_OVERRUN_MINUTES=30          grace after the scheduled end before an unstarted interview expires
# Optional invitation e-mails (needs: npm install nodemailer)
# SMTP_HOST=smtp.example.com  SMTP_PORT=587  SMTP_USER=...  SMTP_PASS=...  SMTP_FROM="ExamSentinel <no-reply@example.com>"
