# Only the backend URL (and other PUBLIC values) belong here. Never put DB passwords,
# Supabase service-role keys or JWT secrets in a mobile app: everything in EXPO_PUBLIC_* ships inside the app.
#
# Local dev on a real phone: your computer's LAN IP, same Wi-Fi.  (localhost = the phone itself!)
#   Android emulator -> http://10.0.2.2:3001      iOS simulator -> http://localhost:3001
EXPO_PUBLIC_API_URL=http://192.168.1.10:3001
